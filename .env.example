# Runtime application database
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/postgres

# Optional separate runtime role
# DATABASE_ADMIN_URL=postgresql+psycopg://<migration-user>:<password>@<host>:5432/postgres

# Alembic requires an explicit target and never falls back to DATABASE_URL.
ALEMBIC_DATABASE_URL=postgresql+psycopg://<migration-user>:<password>@<host>:5432/postgres

GEMINI_API_KEY=<key>
TAVILY_API_KEY=<key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SECRET_KEY=<server-side-secret>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

JWT_SECRET_KEY=<long-random-secret-at-least-32-characters>
SECRET_KEY=<long-random-secret-at-least-32-characters>
GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
VITE_GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAGETRAIL_GUARDRAILS=true
